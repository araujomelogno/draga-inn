{
  "name": "draga-inn",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestión y Gobernanza — Edificio Draga Inn",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-8080}",
    "lint": "next lint --dir app --dir src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "job": "tsx src/jobs/run.ts",
    "docs:manual": "tsx scripts/build-manual.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "drizzle-orm": "^0.38.3",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.2",
    "idb": "^8.0.1",
    "next": "15.1.4",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
