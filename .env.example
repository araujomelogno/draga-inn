# ─── Base de datos (Cloud SQL PostgreSQL 16) ────────────────────────────────
# Local / CI:
DATABASE_URL=postgres://draga:draga@127.0.0.1:5432/draga
# Cloud Run (conector de Cloud SQL por socket Unix):
# DATABASE_URL=postgres://draga@/draga?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ─── Firebase Auth (cliente) ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=draga-inn.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=draga-inn
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (servidor) ──────────────────────────────────────────────
# En Cloud Run se usa la identidad del servicio: no hace falta credencial explícita.
FIREBASE_PROJECT_ID=draga-inn
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# Emulador para desarrollo local:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── Cloud Storage ──────────────────────────────────────────────────────────
GCS_BUCKET=draga-dev-documents
# Cuenta de servicio con iam.serviceAccountTokenCreator para firmar URLs v4:
GCS_SIGNER_SERVICE_ACCOUNT=draga-app@draga-inn.iam.gserviceaccount.com

# ─── Notificaciones ─────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATIONS_FROM="Draga Inn <no-responder@dragainn.uy>"
NOTIFICATIONS_ENABLED=false

# ─── Jobs (Cloud Scheduler → Cloud Run Jobs) ────────────────────────────────
JOBS_OIDC_AUDIENCE=

# ─── Aplicación ─────────────────────────────────────────────────────────────
APP_TIMEZONE=America/Montevideo
NODE_ENV=development
