# ─────────────────────────────────────────────────────────────────────────────
# Imagen de los Cloud Run Jobs. Ejecuta TypeScript con tsx: los jobs son pocos
# y cortos, y así comparten exactamente el mismo código que la aplicación.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production TZ=America/Montevideo
RUN apk add --no-cache tzdata && corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

COPY tsconfig.json ./
COPY src ./src

RUN addgroup -S draga && adduser -S draga -G draga && chown -R draga:draga /app
USER draga

# JOB_NAME lo inyecta Cloud Scheduler en cada disparo.
ENTRYPOINT ["node_modules/.bin/tsx", "src/jobs/run.ts"]
